/* =============================================================================
 * SimAll Beta — Dark theme stylesheet
 * File   : resources/styles/simall_dark.qss
 *
 * Tracks the palette in `ThemeManager::apply_dark_palette()`.
 * Colours below are the canonical accent constants:
 *   surface  : #1E1E1E      surface2 : #252526      surface3 : #333334
 *   text     : #E8E8E8      muted    : #9A9A9A      primary  : #007ACC
 *   success  : #169F6B      warning  : #E0A600      danger   : #E52B50
 * ===========================================================================*/

QWidget {
    background-color: #1E1E1E;
    color:            #E8E8E8;
    selection-background-color: #007ACC;
    selection-color:            #FFFFFF;
}

QMainWindow::separator {
    background: #333334;
    width:  1px;
    height: 1px;
}

QToolTip {
    background-color: #252526;
    color:            #E8E8E8;
    border:           1px solid #555;
    padding:          4px 6px;
}

QMenuBar, QMenu {
    background-color: #252526;
    color:            #E8E8E8;
}
QMenu::item:selected {
    background-color: #007ACC;
    color:            #FFFFFF;
}

QTabWidget::pane    { border: 1px solid #333334; top: -1px; }
QTabBar::tab        { background:#252526; color:#9A9A9A; padding:6px 14px;
                      border:1px solid transparent; }
QTabBar::tab:selected { background:#1E1E1E; color:#E8E8E8;
                        border-bottom-color:#1E1E1E; }
QTabBar::tab:hover   { color:#E8E8E8; }

QToolBar { background:#1E1E1E; border:none; spacing:2px; padding:2px; }
QToolButton {
    background:transparent; color:#E8E8E8;
    padding:4px 6px; border:1px solid transparent; border-radius:3px;
}
QToolButton:hover    { background:#333334; }
QToolButton:checked,
QToolButton:pressed  { background:#007ACC; color:#FFFFFF; }

QPushButton {
    background:#333334; color:#E8E8E8;
    border:1px solid #555; padding:6px 14px; border-radius:3px;
}
QPushButton:hover     { background:#3F3F40; }
QPushButton:default   { border-color:#007ACC; }
QPushButton:disabled  { color:#6E6E6E; background:#2A2A2A; border-color:#3A3A3A; }

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background:#252526; color:#E8E8E8;
    border:1px solid #3F3F40; padding:3px 5px; border-radius:2px;
    selection-background-color:#007ACC;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color:#007ACC;
}
QComboBox::drop-down { border:none; width:18px; }

QCheckBox::indicator,
QRadioButton::indicator {
    width:14px; height:14px; border:1px solid #888; background:#252526;
}
QCheckBox::indicator:checked   { background:#007ACC; border-color:#007ACC; }
QRadioButton::indicator        { border-radius:7px; }
QRadioButton::indicator:checked{ background:#007ACC; border-color:#007ACC; }

QGroupBox {
    border:1px solid #333334; margin-top:14px;
    padding:8px; border-radius:3px;
}
QGroupBox::title {
    subcontrol-origin: margin; left:10px; padding:0 6px;
    color:#9A9A9A;
}

QHeaderView::section {
    background:#252526; color:#9A9A9A;
    padding:4px 8px; border:0; border-right:1px solid #333334;
}
QTableView, QTreeView, QListView {
    background:#1E1E1E; alternate-background-color:#252526;
    gridline-color:#333334; color:#E8E8E8;
    selection-background-color:#007ACC;
}

QScrollBar:vertical, QScrollBar:horizontal { background:#1E1E1E; border:none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background:#3F3F40; border-radius:3px; margin:2px;
}
QScrollBar::handle:hover { background:#555; }
QScrollBar::add-line, QScrollBar::sub-line { background:none; border:none; }

QStatusBar { background:#007ACC; color:#FFFFFF; }
QStatusBar QLabel { color:#FFFFFF; }

QDockWidget {
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/restore.svg);
}
QDockWidget::title {
    background:#252526; color:#9A9A9A; padding:4px 8px;
    border-bottom:1px solid #333334;
}

QSplitter::handle           { background:#333334; }
QSplitter::handle:horizontal{ width:1px; }
QSplitter::handle:vertical  { height:1px; }

QProgressBar {
    background:#252526; border:1px solid #333334; border-radius:2px;
    text-align:center; color:#E8E8E8;
}
QProgressBar::chunk { background:#007ACC; }
