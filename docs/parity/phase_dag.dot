// SimAll Beta — Competitor-parity phase dependency DAG.
//
// Regenerated by Phase 21 Pass 21.4 (2026-05-19) to align with the
// USER'S AUTHORITATIVE 14-PHASE PLAN (P22..P35).  The previous file
// reflected an older 16-phase scheme with sub-letters 29a/b/c/d and
// 32a/b which the user has since superseded — keep the previous
// content in git history if you need it.
//
// Phases:
//   P22 Workbench                — project framework / wizard / model tree
//   P23 Sketcher                 — 2D parametric sketcher for CAD
//   P24 CAD repair               — heal imported geometry (STEP / IGES)
//   P25 Surface remesher         — re-tessellate dirty triangulations
//   P26 Volume meshers           — tetra / hexa / polyhedral generators
//   P27 Wrap                     — geometry wrap for dirty / leaky CAD
//   P28 BC catalogue             — full inlet / outlet / wall library
//   P29 Coupled / density-based  — pressure-coupled + density-based solvers
//   P30 Sliding / dynamic mesh   — MRF, sliding interfaces, 6-DoF, overset
//   P31 Combustion PDF           — flamelet, transported / non-PDF, EDC, NOx
//   P32 Eulerian / DPM / Film    — VOF, mixture, Lagrangian, wall film
//   P33 CFD-Post                 — postprocessing breadth (contours, monitors)
//   P34 DOE                      — design of experiments / param sweeps
//   P35 Validation / Release     — validation matrix + release engineering
//
// Inputs feeding this DAG:
//   docs/parity/feature_inventory.tsv     (Phase 21 Pass 21.1 + 21.2)
//   docs/parity/gap_classification.tsv    (Phase 21 Pass 21.3)
//   /memories/repo/specs/{of_,comsol_,ansys_}*.md  (legacy spec notes)
//
// Render:
//   dot -Tsvg docs/parity/phase_dag.dot -o docs/parity/phase_dag.svg
//   dot -Tpng docs/parity/phase_dag.dot -o docs/parity/phase_dag.png
//
// Conventions:
//   - Node id     = phase id (P21..P35).
//   - Node label  = "Pxx <theme>\n<src dirs primarily touched>".
//   - Node fill   = band color (Band 0..Band 8, see legend cluster).
//   - Edge        = hard dependency  ("B needs A" => A -> B).
//   - Dashed edge = soft / cross-cutting (information-only) dependency.

digraph SimAllParityPhaseDAG {
    rankdir=LR;
    splines=ortho;
    nodesep=0.35;
    ranksep=0.65;
    fontname="Helvetica";
    labelloc="t";
    label="SimAll Beta Competitor-Parity Phase Plan (P21..P35, 14-phase scheme)\nRefreshed by Phase 21 Pass 21.4";

    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.15,0.08"];
    edge [color="#555555", arrowsize=0.7];

    // ---- Band color palette ---------------------------------------------
    // Band 0 evidence          : #d7ccc8 (taupe)        — P21
    // Band 1 foundation        : #c8e6c9 (light green)  — P22
    // Band 2 independent       : #bbdefb (light blue)   — P23 P28 P33
    // Band 3 CAD repair        : #fff9c4 (light yellow) — P24
    // Band 4 surface / wrap    : #ffe0b2 (light orange) — P25 P27
    // Band 5 volume mesh       : #ffcdd2 (light red)    — P26
    // Band 6 solvers / dyn-mesh: #f8bbd0 (light pink)   — P29 P30
    // Band 7 physics extensions: #e1bee7 (light purple) — P31 P32
    // Band 8 DOE + release     : #b39ddb (lavender)     — P34 P35

    // ---- Band 0: evidence base (current phase) --------------------------
    P21 [fillcolor="#d7ccc8",
         label="P21 Parity matrix\nfeature_inventory.tsv +\ncrosswalk source-audit +\ngap tier classification\n[docs/parity, scripts/parity]"];

    // ---- Band 1: workbench foundation -----------------------------------
    P22 [fillcolor="#c8e6c9",
         label="P22 Workbench\nproject framework + wizard +\nmodel tree + material browser +\nsaved views + assembly\n[src/gui, src/gui_core, src/core]"];

    // ---- Band 2: independent buildouts off the workbench ----------------
    P23 [fillcolor="#bbdefb",
         label="P23 Sketcher\n2D parametric sketch primitives +\nconstraints + dimensions +\nextrude / revolve handles\n[src/cad, src/gui]"];
    P28 [fillcolor="#bbdefb",
         label="P28 BC catalogue\ntotalPressure / inletOutlet /\ncodedFixedValue / timeVarying +\nNavierSlip / Fan / Grille /\nScreen / Floquet\n[src/solver, src/zones, src/heat_transfer, src/emag, src/multiphase, src/acoustics]"];
    P33 [fillcolor="#bbdefb",
         label="P33 CFD-Post\nmovable cut-objects + Histogram /\nXY / Polar / Smith / Poincare +\nPNG / SVG / PDF + functionObjects +\nlive force / Cd / Cl monitors\n[src/visualization, src/io, src/gui]"];

    // ---- Band 3: CAD repair --------------------------------------------
    P24 [fillcolor="#fff9c4",
         label="P24 CAD repair\nheal STEP / IGES imports +\nstitch faces / close shells +\nremove tiny edges + tolerant edges\n[src/cad]"];

    // ---- Band 4: surface remesh + wrap ---------------------------------
    P25 [fillcolor="#ffe0b2",
         label="P25 Surface remesher\nre-tessellate dirty surfaces +\nfeature edge preservation +\nsize-field driven retri\n[src/meshing]"];
    P27 [fillcolor="#ffe0b2",
         label="P27 Wrap\ngeometry wrap for dirty / leaky CAD +\nshrink-wrap surface + hole closer +\nproximity refinement\n[src/meshing]"];

    // ---- Band 5: volume meshers ----------------------------------------
    P26 [fillcolor="#ffcdd2",
         label="P26 Volume meshers\ntetra (Delaunay/advancing-front) +\nhexa (snappy/cut-cell) +\npolyhedral conversion +\nprism boundary-layer insertion\n[src/meshing]"];

    // ---- Band 6: coupled solvers + dynamic mesh ------------------------
    P29 [fillcolor="#f8bbd0",
         label="P29 Coupled / density-based\npressure-coupled algorithm +\ndensity-based Roe / AUSM+ / HLL +\ncompressible / supersonic +\nFMG init + pseudo-transient\n[src/solver]"];
    P30 [fillcolor="#f8bbd0",
         label="P30 Sliding / dynamic mesh\nMRF + sliding interfaces +\n6-DoF body motion + overset / chimera +\nremeshing / smoothing\n[src/dynamics, src/rotating, src/meshing]"];

    // ---- Band 7: physics extensions ------------------------------------
    P31 [fillcolor="#e1bee7",
         label="P31 Combustion PDF\nflamelet (steady / FGM) +\ntransported / non-premixed PDF +\nEDC + spark + NOx + soot\n[src/combustion]"];
    P32 [fillcolor="#e1bee7",
         label="P32 Eulerian / DPM / Film\nVOF + level-set + mixture +\nEulerian multifluid + cavitation +\nLagrangian DPM (spray/breakup) +\nEulerian wall film\n[src/multiphase, src/particles]"];

    // ---- Band 8: DOE + validation / release ----------------------------
    P34 [fillcolor="#b39ddb",
         label="P34 DOE\ndesign-of-experiments runner +\nparam sweeps + Latin hypercube +\nresponse-surface fits +\nsensitivity tables\n[src/optimization, src/scripting]"];
    P35 [fillcolor="#b39ddb",
         label="P35 Validation + release\nvalidation matrix (canonical cases) +\nregression harness + perf budgets +\ndocs + packaging / installers\n[tests/regression, docs, packaging]"];

    // ---- HARD edges (dependency graph) ----------------------------------
    // P21 evidence feeds the entire downstream plan.
    P21 -> P22;

    // P22 workbench is the UI host for sketcher, BC dialogs, post views.
    P22 -> P23;
    P22 -> P28;
    P22 -> P33;

    // CAD pipeline: sketcher primitives -> repair -> surface -> volume.
    P23 -> P24;
    P24 -> P25;
    P24 -> P27;          // wrap is an alt path off repaired CAD
    P25 -> P26;
    P27 -> P26;          // wrapped surface also feeds volume mesh

    // Solver / dynamic mesh need BCs and a volume mesh.
    P26 -> P29;
    P28 -> P29;
    P26 -> P30;
    P28 -> P30;

    // Physics extensions ride on the solver.
    P29 -> P31;
    P29 -> P32;
    P28 -> P32;          // multiphase needs phase-specific BCs

    // DOE drives parametric runs of the solver.
    P22 -> P34;          // DOE UI lives in the workbench
    P29 -> P34;

    // Validation + release closes the plan on top of EVERYTHING.
    P30 -> P35;
    P31 -> P35;
    P32 -> P35;
    P33 -> P35;
    P34 -> P35;

    // ---- SOFT / cross-cutting edges (dashed, info only) -----------------
    edge [style=dashed, color="#999999", arrowsize=0.5];
    P26 -> P33 [label="mesh-quality views"];
    P29 -> P33 [label="solver monitors"];
    P30 -> P32 [label="moving multiphase interfaces"];
    P31 -> P32 [label="reacting multiphase / spray combustion"];

    // ---- Legend cluster -------------------------------------------------
    subgraph cluster_legend {
        label = "Bands (recommended execution order)";
        fontsize = 11;
        style = "rounded";
        color = "#bbbbbb";
        node [shape=box, style="rounded,filled", fontsize=9, margin="0.10,0.05"];
        edge [style=invis];

        L0 [fillcolor="#d7ccc8", label="Band 0 — evidence base\n(P21 — current)"];
        L1 [fillcolor="#c8e6c9", label="Band 1 — workbench foundation\n(P22)"];
        L2 [fillcolor="#bbdefb", label="Band 2 — independent buildouts\n(P23 P28 P33)"];
        L3 [fillcolor="#fff9c4", label="Band 3 — CAD repair\n(P24)"];
        L4 [fillcolor="#ffe0b2", label="Band 4 — surface remesh + wrap\n(P25 P27)"];
        L5 [fillcolor="#ffcdd2", label="Band 5 — volume meshers\n(P26)"];
        L6 [fillcolor="#f8bbd0", label="Band 6 — coupled solvers + dyn mesh\n(P29 P30)"];
        L7 [fillcolor="#e1bee7", label="Band 7 — physics extensions\n(P31 P32)"];
        L8 [fillcolor="#b39ddb", label="Band 8 — DOE + release\n(P34 P35)"];

        L0 -> L1 -> L2 -> L3 -> L4 -> L5 -> L6 -> L7 -> L8;
    }
}
