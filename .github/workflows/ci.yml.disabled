# =============================================================================
# ci.yml -- lightweight pre-merge checks
#
# Heavy build + integration testing lives in release.yml (vcpkg, Windows,
# produces installer + portable ZIP).  This workflow stays fast so PR
# feedback is < 2 minutes.
#
# Previous matrix (Windows/Linux x MSVC/GCC/Clang x Debug/Release + ASan)
# was removed because every job required Qt6 + VTK + OpenCASCADE + Eigen3
# + HDF5, and the apt / install-qt-action setup only provided a subset --
# every job failed at the find_package(VTK / OpenCASCADE) step.  Reviving
# multi-platform CI would mean wiring vcpkg into this workflow too, which
# would push PR turnaround from minutes to hours.  Not worth it for now.
# =============================================================================
name: pre-merge-checks

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  format:
    name: clang-format check
    runs-on: ubuntu-22.04
    # Non-gating: a format diff should annoy the author but not block merge.
    # Run `pwsh scripts/format.ps1` locally to fix before pushing.
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - name: Install clang-format + PowerShell
        run: |
          # Pin clang-format to a specific version via pip so the same binary
          # is used locally (pwsh scripts/format.ps1) and in CI -- avoids
          # cross-version reformatting drift between Ubuntu apt clang-format
          # (~v14) and newer releases.
          sudo apt-get update
          sudo apt-get install -y wget apt-transport-https software-properties-common python3-pip
          python3 -m pip install --upgrade "clang-format==22.1.5"
          # Make pip-installed clang-format visible on PATH for pwsh.
          echo "$HOME/.local/bin" >> $GITHUB_PATH
          # PowerShell is needed because scripts/format.ps1 is a .ps1 file.
          wget -q "https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb"
          sudo dpkg -i packages-microsoft-prod.deb
          sudo apt-get update
          sudo apt-get install -y powershell
      - name: Run format check
        shell: pwsh
        run: ./scripts/format.ps1 -Check
